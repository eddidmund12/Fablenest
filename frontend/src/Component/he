// ------------------------------------
// Bookmark notification
// ------------------------------------
const bookmarkNotif = document.createElement("div");
bookmarkNotif.className =
  "fixed top-5 left-1/2 -translate-x-1/2 bg-indigo-500 z-50 text-white text-sm px-4 py-2 rounded shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 md:text-[20px]";
document.body.appendChild(bookmarkNotif);

export function showBookmarkNotif(message: string) {
  bookmarkNotif.textContent = message;
  bookmarkNotif.classList.remove("opacity-0");
  bookmarkNotif.classList.add("opacity-95");

  setTimeout(() => {
    bookmarkNotif.classList.remove("opacity-95");
    bookmarkNotif.classList.add("opacity-0");
  }, 2000);
}